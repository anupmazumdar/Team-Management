# Hustlex Team Workspace - Backend Environment Variables

PORT=5000
NODE_ENV=production

# PostgreSQL Database URL (e.g. Neon, Supabase, or local PostgreSQL)
DATABASE_URL="postgresql://username:password@ep-your-database-host.neon.tech/neondb?sslmode=require"

# JWT Secret for authentication tokens (Generate a random 32+ char secret)
JWT_SECRET="your-secure-jwt-secret-key-min-32-chars"

# Upload Directory
UPLOAD_DIR="./uploads"

# Allowed CORS origins
CORS_ORIGIN="*"
