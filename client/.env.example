# Hustlex Team Workspace - Frontend Environment Variables

# Base API URL (Leave blank or '/api' when deployed with Vercel serverless functions)
VITE_API_URL="https://hustlex-team-workspace-api.onrender.com/api"

# WebSocket URL
VITE_WS_URL="https://hustlex-team-workspace-api.onrender.com"

# Auth0 Single Sign-On (Optional - can be configured in Vercel environment variables)
VITE_AUTH0_DOMAIN="dev-example.us.auth0.com"
VITE_AUTH0_CLIENT_ID="your-auth0-client-id"
VITE_AUTH0_AUDIENCE=""
